#!/usr/bin/env bash
# Setzt die Farben des Duotone-Filters fuer Album- und Playlist-Cover.
#
#   spotify-duotone                  aktuelle Werte anzeigen
#   spotify-duotone '#d9c8d3'        hellen Ton setzen
#   spotify-duotone --dark '#11111b' dunklen Ton setzen
#   spotify-duotone '#d9c8d3' --dark '#11111b'
#
# Uebernimmt Anwenden und Neustart selbst.

set -euo pipefail

EXT="$HOME/.config/spicetify/Extensions/duotone-covers.js"
[[ -f "$EXT" ]] || { echo "Extension nicht gefunden: $EXT" >&2; exit 1; }

zeige() {
  local hell dunkel
  hell=$(grep -oP 'FALLBACK_LIGHT = "\K#[0-9a-fA-F]{6}' "$EXT")
  dunkel=$(grep -oP 'FALLBACK_DARK = "\K#[0-9a-fA-F]{6}' "$EXT")
  echo "  hell   (Lichter)   $hell"
  echo "  dunkel (Schatten)  $dunkel"
}

pruefe() {
  [[ "$1" =~ ^#[0-9a-fA-F]{6}$ ]] || { echo "Keine gueltige Hex-Farbe: $1  (erwartet: #rrggbb)" >&2; exit 1; }
}

setze() {  # $1 = FALLBACK_LIGHT|FALLBACK_DARK, $2 = Farbe
  sed -i -E "s|(const $1 = \")#[0-9a-fA-F]{6}(\";)|\1$2\2|" "$EXT"
}

hell="" ; dunkel=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dark|-d) pruefe "${2:-}"; dunkel="$2"; shift 2 ;;
    --light|-l) pruefe "${2:-}"; hell="$2"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \?//'; exit 0 ;;
    \#*) pruefe "$1"; hell="$1"; shift ;;
    *) echo "Unbekanntes Argument: $1" >&2; exit 1 ;;
  esac
done

if [[ -z "$hell" && -z "$dunkel" ]]; then
  echo "Aktuelle Duotone-Farben:"; zeige; exit 0
fi

[[ -n "$hell"   ]] && setze FALLBACK_LIGHT "$hell"
[[ -n "$dunkel" ]] && setze FALLBACK_DARK  "$dunkel"

echo "Neue Duotone-Farben:"; zeige

lief=0; pgrep -x spotify >/dev/null && lief=1
[[ $lief -eq 1 ]] && pkill -x spotify && sleep 2

spicetify apply >/dev/null 2>&1 && echo "Angewendet."

if [[ $lief -eq 1 ]]; then
  setsid spotify >/dev/null 2>&1 </dev/null & disown
  echo "Spotify neu gestartet."
else
  echo "Spotify lief nicht - beim naechsten Start aktiv."
fi
